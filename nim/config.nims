# Build configuration for the PhotoCraft Nim port.
switch("path", thisDir() & "/src")
switch("path", thisDir() & "/vendor/sdl3")
switch("mm", "orc")
switch("threads", "on")
switch("warning", "UnusedImport:off")
switch("hint", "XDeclaredButNotUsed:off")
switch("hint", "Name:off")
switch("hint", "Link:off")
switch("hint", "Conf:off")
switch("hint", "SuccessX:off")
switch("hint", "Processing:off")
switch("hint", "CC:off")
switch("nimcache", thisDir() & "/.nimcache/" & projectName())
